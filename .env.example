# Anahtarları yalnızca backend .env dosyasında tutun.
WARP_SANDBOX_KEY=wak_test_REPLACE_ME
WARP_LIVE_KEY=wak_live_REPLACE_ME
WARP_BASE_URL=https://www.wearewarp.com/api/v1
WARP_ENV=sandbox

# Backend-only username for partial US city/ZIP autocomplete.
GEONAMES_USERNAME=

# Staff panel credentials. Use a unique password and a random secret of at
# least 32 characters. Keep STAFF_COOKIE_SECURE=true in production.
STAFF_USERNAME=lodestar-staff
STAFF_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
STAFF_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STAFF_COOKIE_SECURE=
STAFF_BOOKING_ENABLED=false

# Persistent customer quote requests (Vercel Marketplace -> Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QUOTE_REQUEST_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Müşterinin teklif seçimi sonrasında göreceği iletişim kanalları.
# WhatsApp numarasını ülke koduyla, boşluk ve + işareti olmadan yazın.
CONTACT_WHATSAPP=
CONTACT_PHONE=
CONTACT_EMAIL=
